<div class="section">
  <div class="section-title"><h2><%= t('account.title') %></h2></div>

  <div class="stat-cards" style="max-width:700px;">
    <div class="stat-card"><div class="num"><%= bonusSummary.balance.toFixed(2) %> ₼</div><div class="label"><%= t('account.bonus_available') %></div></div>
    <div class="stat-card"><div class="num"><%= bonusSummary.pendingTotal.toFixed(2) %> ₼</div><div class="label"><%= t('account.bonus_pending') %> (<%= bonusSummary.holdDays %> <%= t('account.bonus_days') %>)</div></div>
  </div>
  <p style="color:var(--muted);font-size:13.5px;max-width:60ch;">
    <%= t('account.bonus_explain') %>
    <a href="/tereflik"><%= t('account.partner_link') %></a> <%= t('account.partner_explain_suffix') %>
  </p>

  <h3 style="margin-top:28px;"><%= t('account.orders_title') %></h3>
  <% if (!orders.length) { %>
    <p><%= t('account.no_orders') %></p>
  <% } else { %>
    <table class="data-table">
      <thead><tr><th><%= t('account.col_no') %></th><th><%= t('account.col_date') %></th><th><%= t('account.col_amount') %></th><th><%= t('account.col_bonus') %></th><th><%= t('account.col_status') %></th></tr></thead>
      <tbody>
        <% orders.forEach(function(o) { %>
          <tr>
            <td><a href="/hesabim/sifaris/<%= o.id %>">#<%= o.id %></a></td>
            <td><%= o.created_at %></td>
            <td><%= o.total.toFixed(2) %> ₼</td>
            <td><%= o.bonus_earned > 0 ? ('+' + o.bonus_earned.toFixed(2) + ' ₼ (' + t('status.' + o.bonus_status) + ')') : '—' %></td>
            <td><span class="status-tag status-<%= o.status %>"><%= t('status.' + o.status) %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
