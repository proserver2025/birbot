<div class="section">
  <div class="section-title"><h2><%= category.name %></h2></div>
  <% if (!products.length) { %>
    <p><%= t('category.empty') %></p>
  <% } else { %>
    <div class="product-grid">
      <%- include('partials/product-card-list', { products: products }) %>
    </div>
  <% } %>
</div>
