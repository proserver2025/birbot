<div class="section">
  <div class="section-title"><h2><%= t('partner.title') %></h2></div>

  <p style="color:var(--muted);max-width:60ch;">
    <%= t('partner.explain', { pct: commissionPercent, days: holdDays, threshold: threshold }) %>
  </p>

  <% if (error) { %><div class="form-error" style="max-width:500px;"><%= error %></div><% } %>
  <% if (success) { %><div style="background:#dcfce7;color:#166534;padding:11px 14px;border-radius:10px;margin-bottom:16px;max-width:500px;font-size:14px;"><%= success %></div><% } %>

  <div class="admin-card" style="max-width:600px;">
    <h3><%= t('partner.your_link') %></h3>
    <div style="display:flex;gap:10px;">
      <input type="text" id="refLink" readonly value="" style="flex:1;padding:10px;border:1.5px solid var(--border);border-radius:8px;font-size:13px;">
      <button class="btn btn-sm" type="button" onclick="copyLink()"><%= t('partner.copy') %></button>
    </div>
    <p style="font-size:12.5px;color:var(--muted);margin-top:8px;"><%= t('partner.code_label') %>: <strong><%= customer.referral_code %></strong></p>
  </div>

  <div class="stat-cards">
    <div class="stat-card"><div class="num"><%= customer.affiliate_balance.toFixed(2) %> ₼</div><div class="label"><%= t('partner.withdrawable_balance') %></div></div>
    <div class="stat-card"><div class="num"><%= pendingTotal.toFixed(2) %> ₼</div><div class="label"><%= t('partner.pending') %> (<%= holdDays %> <%= t('account.bonus_days') %>)</div></div>
    <div class="stat-card"><div class="num"><%= paidTotal.toFixed(2) %> ₼</div><div class="label"><%= t('partner.paid_so_far') %></div></div>
  </div>

  <div class="admin-card" style="max-width:500px;">
    <h3><%= t('partner.withdraw_title') %></h3>
    <% if (canRequestPayout) { %>
      <form action="/tereflik/cek" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <p><%= t('partner.withdraw_ready', { amount: customer.affiliate_balance.toFixed(2) }) %></p>
        <button class="btn" type="submit"><%= t('partner.payout_btn') %></button>
      </form>
    <% } else { %>
      <p style="color:var(--muted);"><%= t('partner.withdraw_min', { threshold: threshold, remaining: (threshold - customer.affiliate_balance).toFixed(2) }) %></p>
    <% } %>
  </div>

  <% if (referredOrders.length) { %>
  <div class="admin-card">
    <h3><%= t('partner.referred_orders_title') %></h3>
    <table class="data-table">
      <thead><tr><th><%= t('account.col_no') %></th><th><%= t('order.date') %></th><th><%= t('partner.col_product_amount') %></th><th><%= t('partner.col_commission') %></th><th><%= t('order.status') %></th></tr></thead>
      <tbody>
        <% referredOrders.forEach(function(o) { %>
          <tr>
            <td>#<%= o.id %></td>
            <td><%= o.created_at %></td>
            <td><%= o.subtotal.toFixed(2) %> ₼</td>
            <td><%= o.commission_amount.toFixed(2) %> ₼</td>
            <td><span class="status-tag status-<%= o.commission_status === 'temizlendi' ? 'tamamlandi' : (o.commission_status === 'legv_edildi' ? 'legv_edildi' : 'yeni') %>"><%= t('status.' + o.commission_status) %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <% if (payoutRequests.length) { %>
  <div class="admin-card">
    <h3><%= t('partner.history_title') %></h3>
    <table class="data-table">
      <thead><tr><th><%= t('order.date') %></th><th><%= t('partner.col_amount') %></th><th><%= t('order.status') %></th></tr></thead>
      <tbody>
        <% payoutRequests.forEach(function(p) { %>
          <tr><td><%= p.requested_at %></td><td><%= p.amount.toFixed(2) %> ₼</td><td><%= t('status.' + p.status) %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<script>
  document.getElementById('refLink').value = window.location.origin + '/?ref=<%= customer.referral_code %>';
  function copyLink() {
    const input = document.getElementById('refLink');
    input.select();
    navigator.clipboard?.writeText(input.value).catch(() => {});
  }
</script>
