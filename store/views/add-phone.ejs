<div class="form-card">
  <h1><%= t('auth.phone_title') %></h1>
  <p style="color:var(--muted);font-size:14px;"><%= t('auth.phone_text') %></p>
  <% if (error) { %><div class="form-error"><%= error %></div><% } %>
  <form action="/telefon-elave-et" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="redirect" value="<%= redirect %>">
    <div class="form-group"><label><%= t('auth.phone') %></label><input type="text" name="phone" required placeholder="+994 __ ___ __ __" autofocus></div>
    <button class="btn" type="submit" style="width:100%;"><%= t('auth.phone_save_btn') %></button>
  </form>
</div>
