<div class="section">
  <div class="section-title"><h2>Səbətim</h2></div>
  <% if (!cart.length) { %>
    <p>Səbətiniz boşdur. <a href="/mehsullar">Alış-verişə başla</a></p>
  <% } else { %>
    <table class="data-table">
      <thead><tr><th>Məhsul</th><th>Qiymət</th><th>Say</th><th>Cəm</th><th></th></tr></thead>
      <tbody>
        <% cart.forEach(function(i) { %>
          <tr>
            <td><%= i.name %></td>
            <td><%= i.price.toFixed(2) %> ₼</td>
            <td><%= i.qty %></td>
            <td><%= (i.price * i.qty).toFixed(2) %> ₼</td>
            <td>
              <form action="/sebet/sil/<%= i.id %>" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-danger" type="submit">Sil</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <h3 style="text-align:right;margin-top:16px;">Məhsul cəmi: <%= subtotal.toFixed(2) %> ₼</h3>

    <% if (!customer) { %>
      <div class="form-card" style="max-width:460px;text-align:center;">
        <h1>Sifariş vermək üçün qeydiyyatdan keçin</h1>
        <p style="color:var(--muted);font-size:14px;">Qısadır — ad, email, telefon, parol. Google ilə də bir kliklə ola bilər.</p>
        <div style="display:flex;gap:10px;margin-top:16px;">
          <a class="btn" style="flex:1;" href="/qeydiyyat">Qeydiyyat</a>
          <a class="btn btn-outline" style="flex:1;" href="/giris?redirect=%2Fsebet">Giriş</a>
        </div>
      </div>
    <% } else if (needsPhone) { %>
      <div class="form-card" style="max-width:460px;text-align:center;">
        <h1>Telefon nömrənizi tamamlayın</h1>
        <p style="color:var(--muted);font-size:14px;">Sifariş vermədən əvvəl bir dəfəlik telefon nömrənizi əlavə etməlisiniz.</p>
        <a class="btn" href="/telefon-elave-et?redirect=%2Fsebet">Davam et</a>
      </div>
    <% } else { %>

    <div class="form-card" style="margin-top:30px;max-width:520px;">
      <h1>Sifarişi tamamla</h1>
      <form action="/sifaris" method="post" id="checkoutForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group"><label>Ad, Soyad</label><input type="text" name="name" value="<%= customer.full_name %>" required></div>
        <div class="form-group"><label>Telefon</label><input type="text" value="<%= customer.phone %>" disabled style="background:var(--surface-2);"></div>
        <div class="form-group"><label>Çatdırılma ünvanı</label><textarea name="address" rows="3" required></textarea></div>

        <div class="form-group">
          <label>Çatdırılma zonası</label>
          <select name="shipping_zone_id" id="zoneSelect" required onchange="recalc()">
            <option value="">— seçin —</option>
            <optgroup label="Bakı daxili">
              <% zones.filter(z => z.kind === 'city').forEach(function(z) { %>
                <option value="<%= z.id %>" data-price="<%= z.price %>"><%= z.name %> — <%= z.price.toFixed(2) %> ₼</option>
              <% }) %>
            </optgroup>
            <optgroup label="Rayonlar">
              <% zones.filter(z => z.kind === 'region').forEach(function(z) { %>
                <option value="<%= z.id %>" data-price="<%= z.price %>"><%= z.name %> — <%= z.price.toFixed(2) %> ₼</option>
              <% }) %>
            </optgroup>
          </select>
          <p style="font-size:12px;color:var(--muted);margin-top:4px;">
            Çatdırılma qiyməti bir sifarişə görədir (neçə məhsul olmasından asılı olmayaraq) — hamısı birlikdə göndərilir.
          </p>
        </div>

        <% if (warrantyEnabled) { %>
        <div class="form-group" style="background:var(--surface-2);padding:12px;border-radius:10px;">
          <label style="display:flex;align-items:flex-start;gap:8px;">
            <input type="checkbox" name="warranty" id="warrantyCheck" style="width:auto;margin-top:3px;" onchange="recalc()">
            <span>
              <strong>Zəmanət talonu istəyirəm (+<%= warrantyPrice.toFixed(2) %> ₼)</strong><br>
              <span style="font-size:12.5px;color:var(--muted);"><%= warrantyTerms %></span>
            </span>
          </label>
        </div>
        <% } %>

        <% if (bonusSummary && bonusSummary.balance > 0) { %>
        <div class="form-group" style="background:var(--accent-tint,#fef3e2);padding:12px;border-radius:10px;">
          <label style="font-weight:600;">💰 Bonus balansından istifadə et (mövcud: <%= bonusSummary.balance.toFixed(2) %> ₼)</label>
          <input type="number" name="bonus_use" id="bonusUse" step="0.01" min="0" max="<%= bonusSummary.balance %>" value="0" oninput="recalc()" style="margin-top:6px;">
        </div>
        <% } %>

        <div style="border-top:1px solid var(--border);margin:16px 0;padding-top:12px;font-size:14px;">
          <div style="display:flex;justify-content:space-between;"><span>Məhsul cəmi</span><span id="sumSubtotal"><%= subtotal.toFixed(2) %> ₼</span></div>
          <div style="display:flex;justify-content:space-between;"><span>Çatdırılma</span><span id="sumShipping">0.00 ₼</span></div>
          <% if (warrantyEnabled) { %>
          <div style="display:flex;justify-content:space-between;"><span>Zəmanət</span><span id="sumWarranty">0.00 ₼</span></div>
          <% } %>
          <% if (bonusSummary && bonusSummary.balance > 0) { %>
          <div style="display:flex;justify-content:space-between;color:var(--success);"><span>Bonus endirimi</span><span id="sumBonus">-0.00 ₼</span></div>
          <% } %>
          <div style="display:flex;justify-content:space-between;font-weight:700;font-size:16px;margin-top:8px;"><span>Ödəniləcək</span><span id="sumTotal"><%= subtotal.toFixed(2) %> ₼</span></div>
        </div>

        <button class="btn" type="submit" style="width:100%;">Sifarişi təsdiqlə</button>
      </form>
    </div>

    <script>
      const SUBTOTAL = <%= subtotal %>;
      const WARRANTY_PRICE = <%= warrantyEnabled ? warrantyPrice : 0 %>;
      const BONUS_BALANCE = <%= bonusSummary ? bonusSummary.balance : 0 %>;
      function recalc() {
        const sel = document.getElementById('zoneSelect');
        const opt = sel.options[sel.selectedIndex];
        const shippingFee = opt && opt.dataset.price ? parseFloat(opt.dataset.price) : 0;
        const wCheck = document.getElementById('warrantyCheck');
        const warranty = wCheck && wCheck.checked ? WARRANTY_PRICE : 0;
        const bonusInput = document.getElementById('bonusUse');
        let bonusUse = bonusInput ? Math.max(0, Math.min(parseFloat(bonusInput.value) || 0, BONUS_BALANCE)) : 0;
        const gross = SUBTOTAL + shippingFee + warranty;
        bonusUse = Math.min(bonusUse, gross);

        document.getElementById('sumShipping').textContent = shippingFee.toFixed(2) + ' ₼';
        const wEl = document.getElementById('sumWarranty');
        if (wEl) wEl.textContent = warranty.toFixed(2) + ' ₼';
        const bEl = document.getElementById('sumBonus');
        if (bEl) bEl.textContent = '-' + bonusUse.toFixed(2) + ' ₼';
        document.getElementById('sumTotal').textContent = (gross - bonusUse).toFixed(2) + ' ₼';
      }
    </script>
    <% } %>
  <% } %>
</div>
