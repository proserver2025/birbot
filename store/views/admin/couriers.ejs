<div class="admin-topbar"><h1>Kuryerlər</h1></div>

<div class="admin-card" style="max-width:600px;">
  <h3>Yeni kuryer</h3>
  <form action="/admin/kuryerler/yeni" method="post" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group" style="flex:2;margin:0;"><label>Ad, soyad</label><input type="text" name="full_name" required></div>
    <div class="form-group" style="flex:1;margin:0;"><label>Telefon</label><input type="text" name="phone"></div>
    <button class="btn" type="submit">Əlavə et</button>
  </form>
</div>

<div class="admin-card">
  <table class="data-table">
    <thead><tr><th>Ad</th><th>Telefon</th><th>Aktiv sifariş</th><th>Aktiv</th><th></th></tr></thead>
    <tbody>
      <% if (!couriers.length) { %><tr><td colspan="5" style="color:var(--muted);">Hələ kuryer yoxdur.</td></tr><% } %>
      <% couriers.forEach(function(c) { %>
        <tr>
          <form action="/admin/kuryerler/<%= c.id %>/redakte" method="post" style="display:contents;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <td><input type="text" name="full_name" value="<%= c.full_name %>" style="width:100%;padding:6px;border:1px solid var(--border);border-radius:6px;"></td>
            <td><input type="text" name="phone" value="<%= c.phone || '' %>" style="width:100%;padding:6px;border:1px solid var(--border);border-radius:6px;"></td>
            <td><%= c.active_order_count %></td>
            <td><input type="checkbox" name="is_active" <%= c.is_active ? 'checked' : '' %> style="width:auto;"></td>
            <td style="display:flex;gap:6px;">
              <button class="btn btn-sm btn-outline" type="submit">Saxla</button>
          </form>
              <% if (c.active_order_count === 0) { %>
              <form action="/admin/kuryerler/<%= c.id %>/sil" method="post" onsubmit="return confirm('Silinsin?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-danger" type="submit">Sil</button>
              </form>
              <% } %>
            </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
