<!doctype html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
  <div class="login-screen">
    <div class="form-card">
      <h1>🔐 Admin Panel</h1>
      <% if (error) { %><div class="form-error"><%= error %></div><% } %>
      <form action="/admin/login" method="post">
        <div class="form-group"><label>İstifadəçi adı</label><input type="text" name="username" required autofocus></div>
        <div class="form-group"><label>Parol</label><input type="password" name="password" required></div>
        <button class="btn" type="submit" style="width:100%;">Daxil ol</button>
      </form>
    </div>
  </div>
</body>
</html>
