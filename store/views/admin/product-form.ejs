<div class="admin-topbar"><h1><%= product ? 'Məhsulu redaktə et' : 'Yeni məhsul' %></h1></div>
<div class="admin-card" style="max-width:600px;">
  <form action="<%= product ? ('/admin/mehsullar/' + product.id + '/redakte') : '/admin/mehsullar/yeni' %>" method="post" enctype="multipart/form-data">
    <div class="form-group"><label>Ad</label><input type="text" name="name" value="<%= product ? product.name : '' %>" required></div>
    <div class="form-group"><label>Təsvir</label><textarea name="description" rows="4"><%= product ? product.description : '' %></textarea></div>
    <div class="form-group"><label>Qiymət (₼)</label><input type="number" step="0.01" name="price" value="<%= product ? product.price : '' %>" required></div>
    <div class="form-group"><label>Əvvəlki qiymət (endirim üçün, boş saxlaya bilərsiniz)</label><input type="number" step="0.01" name="compare_at_price" value="<%= product && product.compare_at_price ? product.compare_at_price : '' %>"></div>
    <div class="form-group"><label>Stok (say)</label><input type="number" name="stock" value="<%= product ? product.stock : 0 %>" required></div>
    <div class="form-group">
      <label>Kateqoriya</label>
      <select name="category_id">
        <option value="">— seçin —</option>
        <% categories.forEach(function(c) { %>
          <option value="<%= c.id %>" <%= product && product.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-group"><label>Şəkil</label><input type="file" name="image" accept="image/*">
      <% if (product && product.image_url) { %><img src="<%= product.image_url %>" style="width:80px;margin-top:8px;border-radius:6px;"><% } %>
    </div>
    <div class="form-group">
      <label><input type="checkbox" name="is_active" <%= !product || product.is_active ? 'checked' : '' %> style="width:auto;display:inline;"> Aktiv (saytda görünsün)</label>
    </div>
    <div class="form-group">
      <label><input type="checkbox" name="is_featured" <%= product && product.is_featured ? 'checked' : '' %> style="width:auto;display:inline;"> Seçilmiş məhsul (ana səhifədə göstər)</label>
    </div>
    <button class="btn" type="submit">Yadda saxla</button>
  </form>
</div>
