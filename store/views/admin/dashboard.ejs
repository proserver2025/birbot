<div class="admin-topbar"><h1>Dashboard</h1></div>
<div class="stat-cards">
  <div class="stat-card"><div class="num"><%= stats.products %></div><div class="label">Məhsul</div></div>
  <div class="stat-card"><div class="num"><%= stats.orders %></div><div class="label">Sifariş</div></div>
  <div class="stat-card"><div class="num"><%= stats.customers %></div><div class="label">Müştəri</div></div>
  <div class="stat-card"><div class="num"><%= stats.revenue.toFixed(2) %> ₼</div><div class="label">Ümumi satış</div></div>
</div>

<div class="admin-card">
  <h3>Son sifarişlər</h3>
  <table class="data-table">
    <thead><tr><th>№</th><th>Müştəri</th><th>Məbləğ</th><th>Status</th><th>Tarix</th></tr></thead>
    <tbody>
      <% recentOrders.forEach(function(o) { %>
        <tr>
          <td><a href="/admin/sifarisler/<%= o.id %>">#<%= o.id %></a></td>
          <td><%= o.customer_name %></td>
          <td><%= o.total.toFixed(2) %> ₼</td>
          <td><span class="status-tag status-<%= o.status %>"><%= o.status %></span></td>
          <td><%= o.created_at %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
