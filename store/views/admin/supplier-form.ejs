<div class="admin-topbar"><h1><%= supplier ? 'Təchizatçını redaktə et' : 'Yeni təchizatçı' %></h1></div>

<div class="admin-card" style="max-width:560px;">
  <form action="<%= supplier ? ('/admin/saticilar/' + supplier.id + '/redakte') : '/admin/saticilar/yeni' %>" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group"><label>Şirkət / mağaza adı</label><input type="text" name="company_name" value="<%= supplier ? supplier.company_name : '' %>" required></div>
    <div class="form-group"><label>Əlaqə şəxsi</label><input type="text" name="contact_person" value="<%= supplier && supplier.contact_person ? supplier.contact_person : '' %>"></div>
    <div class="form-group"><label>Telefon</label><input type="text" name="phone" value="<%= supplier && supplier.phone ? supplier.phone : '' %>"></div>
    <div class="form-group"><label>Email</label><input type="email" name="email" value="<%= supplier && supplier.email ? supplier.email : '' %>"></div>
    <div class="form-group"><label>Ünvan</label><textarea name="address" rows="2"><%= supplier && supplier.address ? supplier.address : '' %></textarea></div>
    <div class="form-group"><label>VÖEN</label><input type="text" name="tax_id" value="<%= supplier && supplier.tax_id ? supplier.tax_id : '' %>"></div>
    <div class="form-group"><label>Bank rekvizitləri</label><textarea name="bank_info" rows="2"><%= supplier && supplier.bank_info ? supplier.bank_info : '' %></textarea></div>
    <div class="form-group"><label>Qeydlər</label><textarea name="notes" rows="2"><%= supplier && supplier.notes ? supplier.notes : '' %></textarea></div>
    <% if (supplier) { %>
    <div class="form-group">
      <label><input type="checkbox" name="is_active" <%= supplier.is_active ? 'checked' : '' %> style="width:auto;display:inline;"> Aktiv</label>
    </div>
    <% } %>
    <button class="btn" type="submit">Yadda saxla</button>
  </form>
</div>

<% if (typeof products !== 'undefined' && products.length) { %>
<div class="admin-card" style="max-width:560px;">
  <h3>Bu təchizatçının məhsulları</h3>
  <table class="data-table">
    <thead><tr><th>Ad</th><th>Qiymət</th><th>Stok</th></tr></thead>
    <tbody>
      <% products.forEach(function(p) { %>
        <tr><td><a href="/admin/mehsullar/<%= p.id %>/redakte"><%= p.name %></a></td><td><%= p.price.toFixed(2) %> ₼</td><td><%= p.stock %></td></tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
