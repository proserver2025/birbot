<div class="admin-topbar"><h1>Kuryer izləmə</h1></div>
<p style="color:var(--muted);max-width:70ch;margin-top:-10px;">
  Aktiv sifarişlər, təyin olunan kuryer və son çatdırılma statusu bir yerdə. "Mal haradadır" sualına cavab üçün ətraflı
  görünüşə keçin.
</p>

<div class="admin-card">
  <table class="data-table">
    <thead><tr><th>№</th><th>Müştəri</th><th>Status</th><th>Kuryer</th><th>Son izləmə</th><th>Çat</th><th></th></tr></thead>
    <tbody>
      <% if (!orders.length) { %><tr><td colspan="7" style="color:var(--muted);">Aktiv sifariş yoxdur.</td></tr><% } %>
      <% orders.forEach(function(o) { %>
        <tr>
          <td><%= o.id %></td>
          <td><%= o.customer_name %></td>
          <td><span class="status-tag status-<%= o.status %>"><%= o.status %></span></td>
          <td>
            <form action="/admin/sifarisler/<%= o.id %>/kuryer" method="post" style="display:flex;gap:6px;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <select name="courier_id" onchange="this.form.submit()" style="padding:5px;border:1px solid var(--border);border-radius:6px;">
                <option value="">— seç —</option>
                <% couriers.forEach(function(c) { %>
                  <option value="<%= c.id %>" <%= o.courier_id === c.id ? 'selected' : '' %>><%= c.full_name %></option>
                <% }) %>
              </select>
            </form>
          </td>
          <td>
            <% if (o.last_tracking_status) { %>
              <strong><%= o.last_tracking_status %></strong><br><span style="color:var(--muted);font-size:12px;"><%= o.last_tracking_at %></span>
            <% } else { %>
              <span style="color:var(--muted);">—</span>
            <% } %>
          </td>
          <td><% if (o.unread_count > 0) { %><span class="unread-badge"><%= o.unread_count %></span><% } %></td>
          <td><a class="btn btn-sm btn-outline" href="/admin/sifarisler/<%= o.id %>">Ətraflı</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
