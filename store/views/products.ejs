<div class="section">
  <div class="section-title">
    <h2><%= q ? (t('products.search_prefix') + ': "' + q + '"') : t('products.title') %></h2>
  </div>
  <% if (!products.length) { %>
    <p><%= t('products.empty') %></p>
  <% } else { %>
    <div class="product-grid">
      <%- include('partials/product-card-list', { products: products }) %>
    </div>
  <% } %>
</div>
