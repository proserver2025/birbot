<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h4><%= t('footer.about_title') %></h4>
        <p><%= t('footer.about_text') %></p>
        <div class="footer-social">
          <a href="<%= brand.telegram %>" target="_blank" rel="noopener" title="Telegram">✈️</a>
          <a href="<%= brand.instagram %>" target="_blank" rel="noopener" title="Instagram">📷</a>
          <a href="<%= brand.facebook %>" target="_blank" rel="noopener" title="Facebook">📘</a>
          <a href="<%= brand.tiktok %>" target="_blank" rel="noopener" title="TikTok">🎵</a>
          <a href="<%= brand.youtube %>" target="_blank" rel="noopener" title="YouTube">▶️</a>
        </div>
      </div>
      <div>
        <h4><%= t('footer.contact_title') %></h4>
        <p>📞 <a href="tel:<%= brand.phoneHref %>"><%= brand.phone %></a></p>
        <p>✉️ <a href="mailto:<%= brand.email %>"><%= brand.email %></a></p>
      </div>
      <div>
        <h4><%= t('footer.links_title') %></h4>
        <p><a href="/haqqimizda"><%= t('nav.about') %></a></p>
        <p><a href="/mehsullar"><%= t('nav.products_short') %></a></p>
        <p><a href="/hesabim"><%= t('account.title') %></a></p>
        <p><a href="/sebet"><%= t('cart.title') %></a></p>
      </div>
    </div>
    <div class="footer-bottom">
      &copy; <%= new Date().getFullYear() %> SaaS Home. <%= t('footer.rights') %> ·
      <%= t('footer.made_by') %>: <a href="https://smai.pro" target="_blank" rel="noopener" style="font-weight:700;">SMAI</a>
    </div>
  </div>
</footer>
