<div class="hero" style="margin-left:-16px;margin-right:-16px;border-radius:12px;padding-left:40px;padding-right:40px;">
  <h1><%= t('home.hero_title') %></h1>
  <p><%= t('home.hero_text') %></p>
  <a href="/mehsullar" class="btn"><%= t('home.hero_cta') %></a>
</div>

<section class="section">
  <div class="section-title"><h2><%= t('home.categories_title') %></h2></div>
  <div class="cat-pill-grid">
    <% categories.forEach(function(c) { %>
      <a class="cat-pill" href="/kateqoriya/<%= c.slug %>"><%= c.name %></a>
    <% }) %>
  </div>
</section>

<% if (featured.length) { %>
<section class="section">
  <div class="section-title"><h2><%= t('home.featured_title') %></h2><a href="/mehsullar"><%= t('home.view_all') %></a></div>
  <div class="product-grid">
    <%- include('partials/product-card-list', { products: featured }) %>
  </div>
</section>
<% } %>

<section class="section">
  <div class="section-title"><h2><%= t('home.new_arrivals_title') %></h2><a href="/mehsullar"><%= t('home.view_all') %></a></div>
  <div class="product-grid">
    <%- include('partials/product-card-list', { products: latest }) %>
  </div>
</section>
