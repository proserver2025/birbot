<div class="form-card">
  <h1>Giriş</h1>
  <% if (error) { %><div class="form-error"><%= error %></div><% } %>
  <form action="/giris" method="post">
    <input type="hidden" name="redirect" value="<%= redirect %>">
    <div class="form-group"><label>Email</label><input type="email" name="email" required></div>
    <div class="form-group"><label>Parol</label><input type="password" name="password" required></div>
    <button class="btn" type="submit" style="width:100%;">Daxil ol</button>
  </form>
  <p style="margin-top:14px;text-align:center;">Hesabın yoxdur? <a href="/qeydiyyat">Qeydiyyatdan keç</a></p>
</div>
