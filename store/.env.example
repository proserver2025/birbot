PORT=3000
NODE_ENV=development
SESSION_SECRET=change_this_to_a_long_random_string
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change_this_password

# Optional: "Google ilə daxil ol" düyməsini aktivləşdirmək üçün.
# https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
# Authorized JavaScript origin: https://sənin-domenin.az
# Boş saxlasan, Google düyməsi sadəcə görünmür, sayt normal işləyir.
GOOGLE_CLIENT_ID=
